{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "rangeStrategy": "pin",
  "timezone": "Europe/Paris",
  "enabledManagers": [
    "dockerfile",
    "github-actions",
    "npm",
    "submodules"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "submodules"
      ],
      "groupName": "git-submodules"
    }
  ]
}
